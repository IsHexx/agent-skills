    "domain": "Domain",
    "test_type": "Test type",
    "case_start": "Case start",
    "case_end": "Case end",
    "execution_start": "Planned start",
    "execution_end": "Planned end",
    "actual_start": "Actual start",
    "actual_end": "Actual end",
    "expected_test": "Expected test date",
    "expected_launch": "Expected launch date",
    "remark": "Remark"
